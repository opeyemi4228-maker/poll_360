// Poll360 storage.
//
// ── EVERY COLUMN NAME IS PRESERVED ─────────────────────────────────────────
// The models are camelCase because that is what the application reads; the
// tables and columns keep the snake_case names they already had, through @map.
// A migration that also renames things is two migrations pretending to be one,
// and the second one is the one that loses data.
//
// ── WHAT IS SCOPED TO AN ELECTION, AND WHAT IS NOT ─────────────────────────
// Accounts, sessions, access requests and the audit log outlive any single
// election: the same coordinator works the presidential and then the
// governorship, and an audit trail that reset every project would be useless.
// Everything operational — results, incidents, the payment ledger, discovered
// units, read sheets, positions — belongs to exactly one election, and carries
// its id. That is what makes a new project a clean slate without deleting a
// single row of the last one.

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// An election project. Everything operational hangs off one of these.
model Election {
  id        String    @id
  /// Required, and required *before* anything can be filed against it: an
  /// untitled project is one nobody can identify at 2am three elections later.
  title     String
  slug      String    @unique
  kind      String    @default("PRESIDENTIAL")
  /// The polling day itself, which is not the day the project was created.
  votesOn   DateTime? @map("votes_on") @db.Timestamptz(3)
  status    String    @default("DRAFT")
  /// True only for the built-in 2023 replay, so the interface can say plainly
  /// that what is on screen is a demonstration and not somebody's live count.
  isDemo    Boolean   @default(false) @map("is_demo")
  note      String?
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  closedAt  DateTime? @map("closed_at") @db.Timestamptz(3)

  results      Result[]
  incidents    Incident[]
  ledger       LedgerEntry[]
  pollingUnits PollingUnit[]
  sheetReads   SheetRead[]
  positions    WaPosition[]
  declared     Declared[]

  @@index([status, createdAt])
  @@map("elections")
}

model User {
  id           String    @id
  name         String
  email        String?   @unique
  phone        String?   @unique
  passwordHash String    @map("password_hash")
  role         String    @default("VIEWER")
  scope        String?
  /// ACTIVE, PENDING or DECLINED.
  ///
  /// ── THREE STATES, BECAUSE TWO COULD NOT SAY IT ───────────────────────────
  /// Coordinators sign themselves up at /join and an administrator approves
  /// them before anything they file enters the count. An account nobody has
  /// looked at yet and an account somebody switched off are different facts,
  /// and `disabledAt` could only express the second — so a queue built on it
  /// would have buried real applicants among revoked accounts, and approving
  /// one would have quietly reinstated the other. Defaults to ACTIVE, so every
  /// account issued by an administrator is unaffected without a backfill.
  status       String    @default("ACTIVE")
  approvedBy   String?   @map("approved_by")
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(3)
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(3)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  sessions             Session[]
  coordinatorsApproved Coordinator[] @relation("CoordinatorApprovedBy")
  resultsFiled     Result[]      @relation("ResultSubmittedBy")
  resultsVerified  Result[]      @relation("ResultVerifiedBy")
  incidents        Incident[]
  ledgerEntries    LedgerEntry[]
  waContacts       WaContact[]

  @@index([status, createdAt])
  @@map("users")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AccessRequest {
  id           String   @id
  organisation String
  name         String
  email        String
  phone        String?
  kind         String
  election     String?
  units        Int?
  message      String?
  status       String   @default("NEW")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("access_requests")
}

/// One row per booth per position per election. The unique triple is the whole
/// point: a booth reports each contest once, and a correction updates that row
/// rather than adding a second.
///
/// ── THE PAIR WAS NOT ENOUGH, AND THE FAILURE WAS SILENT ────────────────────
/// This was `@@unique([electionId, unitCode])`, which is correct for a project
/// holding one contest and wrong for a night with five ballot papers on it: the
/// governorship return from a booth that had already filed the presidential was
/// rejected by a constraint, and the constraint was Prisma's, under a name that
/// appears nowhere in lib/db.js. Both owners of this schema now describe the
/// same rule.
model Result {
  id          String    @id
  electionId  String    @map("election_id")
  /// Which ballot paper these figures came off: PRESIDENTIAL, GOVERNORSHIP,
  /// SENATE, REPRESENTATIVES or LGA — the list in lib/races.js. A booth counts
  /// several piles on one evening and each is a separate return; summing them
  /// produces a figure that describes nothing. Defaulted rather than left
  /// nullable so no reader has to decide what a null means.
  race        String    @default("PRESIDENTIAL")
  unitCode    String    @map("unit_code")
  stateCode   String    @map("state_code")
  registered  Int
  accredited  Int
  rejected    Int       @default(0)
  /// JSON, kept as text exactly as it was stored. Changing the storage engine
  /// and the column type in one step is how a migration quietly loses a row.
  votes       String
  /// Predates the `declared` table and is left exactly where it is: the seeder
  /// still writes it, and dropping a column is how a migration loses data
  /// somebody was still reading. Per-party and per-ward declared figures live
  /// in Declared below, which a single integer could never express.
  inecTotal   Int?      @map("inec_total")
  /// Whether the photographed sheet was compared to these figures, and what
  /// the comparison found. Null means no comparison happened, which is not the
  /// same as one that agreed and must never be stored as though it were.
  sheetMatch  String?   @map("sheet_match")
  status      String    @default("SUBMITTED")
  note        String?
  lat         Float?
  lon         Float?
  accuracy    Float?
  distanceM   Float?    @map("distance_m")
  source      String    @default("APP")
  repName     String?   @map("rep_name")

  /// ── FORM EC8A, BOX BY BOX ───────────────────────────────────────────────
  /// The eight numbered boxes at the head of the sheet, plus the parts of it
  /// that are not figures. All nullable, for two separate reasons that must
  /// not be confused: every row filed before these existed has none of them,
  /// and a photograph or a hurried agent may genuinely leave one unread. Null
  /// means "not captured" and is never rendered as a zero — a zero is a
  /// measurement and these are the absence of one.
  ///
  /// Why capture boxes the count does not need: because the sheet's own
  /// arithmetic is the strongest evidence there is about whether it was
  /// transcribed honestly, and it cannot be checked from figures nobody
  /// stored. #3 minus #4 must equal #8, and #5 + #6 + #7 must equal #8. The
  /// first real sheet this product was shown fails both by exactly one — the
  /// presiding officer wrote the accredited figure into #8 and lost the
  /// spoiled ballot. See auditSheet in lib/results.js.
  ///
  /// The serial number. Pre-printed and unique to one sheet, which makes it
  /// the only field on the paper that can prove two returns came off two
  /// different pieces of paper rather than one photographed twice.
  formSerial    String?  @map("form_serial")
  /// #3, ballot papers issued to the polling unit.
  ballotsIssued Int?     @map("ballots_issued")
  /// #4, unused ballot papers.
  unusedBallots Int?     @map("unused_ballots")
  /// #5, spoiled ballot papers. Not the same as rejected: a spoiled paper was
  /// mismarked and replaced before it went in the box, so it is issued but
  /// never cast, and it is the difference between #8 and the accredited count.
  spoiled       Int?
  /// #7 as the officer wrote it, kept beside the sum of the party rows rather
  /// than instead of it. Where the two disagree the sheet disagrees with
  /// itself, and that is a finding, not something to reconcile away.
  statedValid   Int?     @map("stated_valid")
  /// #8, total used ballot papers.
  usedBallots   Int?     @map("used_ballots")
  /// The presiding officer strikes out one of "CONTESTED / NOT CONTESTED".
  /// True means an agent disputed the result at the booth, which is a fact
  /// about the count that no figure on the sheet carries.
  contested     Boolean? 
  /// The date written on the form, as written. Text and not a date: this is a
  /// transcription of what a human wrote in a box, and parsing it into a
  /// timestamp would quietly invent a day for anything ambiguous.
  sheetDate     String?  @map("sheet_date")
  /// The polling agents who signed, keyed by party id. JSON, because the set
  /// of parties differs by paper and a column each would be eighteen columns
  /// that are almost always null. This is the witness record: who stood at
  /// this booth and put their name to this figure.
  agents        String?
  /// ── EXACTLY ONE AUTHOR, AND THE DATABASE ENFORCES IT ────────────────────
  /// A return is filed either by a Poll360 staff account or by a polling unit
  /// coordinator, and those live in separate tables. `submittedBy` was NOT NULL
  /// and still holds the author of every return filed before coordinators had
  /// their own accounts; repointing it at a table those rows have no entry in
  /// would have lost the authorship of all of them. So a second column was
  /// added instead, and a CHECK constraint — results_one_author, in the
  /// migration — makes exactly one of the pair non-null. A result nobody filed
  /// is not a result; one filed by two people is a bug that would surface for
  /// the first time in a tribunal.
  submittedBy   String?  @map("submitted_by")
  coordinatorId String?  @map("coordinator_id")
  submittedAt DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(3)
  verifiedBy  String?   @map("verified_by")
  verifiedAt  DateTime? @map("verified_at") @db.Timestamptz(3)

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  filedBy  User?        @relation("ResultSubmittedBy", fields: [submittedBy], references: [id])
  filedByCoordinator Coordinator? @relation(fields: [coordinatorId], references: [id])
  checkedBy User?   @relation("ResultVerifiedBy", fields: [verifiedBy], references: [id])

  @@unique([electionId, race, unitCode])
  @@index([electionId, stateCode, submittedAt])
  @@index([electionId, status])
  @@index([electionId, race, submittedAt])
  @@map("results")
}

model Incident {
  id           String   @id
  electionId   String   @map("election_id")
  unitCode     String   @map("unit_code")
  stateCode    String   @map("state_code")
  kind         String
  severity     String   @default("INFO")
  detailSealed String?  @map("detail_sealed")
  status       String   @default("OPEN")
  /// The same two-table bridge as Result above: incidents come from the same
  /// people, and a coordinator is not in `users`.
  reportedBy    String?  @map("reported_by")
  coordinatorId String?  @map("coordinator_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  reporter User?        @relation(fields: [reportedBy], references: [id])
  reporterCoordinator Coordinator? @relation(fields: [coordinatorId], references: [id])
  media    Media[]

  @@index([electionId, createdAt])
  @@index([electionId, stateCode])
  @@map("incidents")
}

model Media {
  id         String   @id
  incidentId String   @map("incident_id")
  mime       String
  bytes      Bytes
  width      Int?
  height     Int?
  hash       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  incident    Incident    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  waMessages  WaMessage[]

  @@index([incidentId])
  @@map("media")
}

model Audit {
  id        String   @id
  actorId   String?  @map("actor_id")
  actorName String?  @map("actor_name")
  action    String
  subject   String?
  meta      String?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("audit")
}

/// The agent payment ledger. `seq` is the chain order and must be storage-level
/// and strictly monotonic: every entry's hash depends on the one before it, so
/// two rows written in the same millisecond still need an unambiguous
/// predecessor. There is deliberately no update or delete path to this table.
model LedgerEntry {
  seq          Int      @id @default(autoincrement())
  id           String   @unique
  electionId   String   @map("election_id")
  userId       String   @map("user_id")
  kind         String
  amount       Int
  reference    String
  note         String?
  createdAt    DateTime @map("created_at") @db.Timestamptz(3)
  previousHash String   @map("previous_hash")
  hash         String
  actorId      String?  @map("actor_id")

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([electionId, userId, seq])
  @@map("ledger")
}

model WaContact {
  id           String   @id
  phoneSealed  String   @map("phone_sealed")
  phoneIndex   String   @unique @map("phone_index")
  phoneTail    String   @map("phone_tail")
  displayName  String?  @map("display_name")
  userId       String?  @map("user_id")
  unitCode     String?  @map("unit_code")
  stateCode    String?  @map("state_code")
  status       String   @default("UNVERIFIED")
  firstSeen    DateTime @default(now()) @map("first_seen") @db.Timestamptz(3)
  lastSeen     DateTime @default(now()) @map("last_seen") @db.Timestamptz(3)
  messageCount Int      @default(0) @map("message_count")

  user      User?        @relation(fields: [userId], references: [id])
  messages  WaMessage[]
  session   WaSession?
  positions WaPosition[]
  reads     SheetRead[]

  @@index([lastSeen])
  @@map("wa_contacts")
}

model WaMessage {
  id         String   @id
  waId       String?  @unique @map("wa_id")
  contactId  String   @map("contact_id")
  direction  String
  kind       String   @default("text")
  bodySealed String?  @map("body_sealed")
  mediaId    String?  @map("media_id")
  step       String?
  status     String   @default("RECEIVED")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  contact WaContact @relation(fields: [contactId], references: [id])
  media   Media?    @relation(fields: [mediaId], references: [id])

  @@index([contactId, createdAt])
  @@index([createdAt])
  @@map("wa_messages")
}

model WaSession {
  contactId String   @id @map("contact_id")
  step      String
  draft     String   @default("{}")
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  attempts  Int      @default(0)

  contact WaContact @relation(fields: [contactId], references: [id])

  @@map("wa_sessions")
}

/// Units as they are discovered in the field. Scoped to an election because a
/// register is revised between them, and last year's booth list is not this
/// year's.
model PollingUnit {
  /// The default is gone, which is what the note here used to ask for.
  /// It was a bridge for raw-SQL writers that predated elections, and it
  /// did exactly the damage a silent default does: every reading taken since
  /// projects existed landed in the 2023 project regardless of which one was
  /// running, so a rehearsal read a sheet and its own dashboard stayed empty.
  /// `sheetReads.record` now refuses without an election id, which fails
  /// loudly in one place instead of quietly in every project.
  electionId String   @map("election_id")
  code       String
  stateCode  String   @map("state_code")
  lgaCode    String   @map("lga_code")
  wardCode   String   @map("ward_code")
  unitNo     String   @map("unit_no")
  name       String?
  wardName   String?  @map("ward_name")
  lgaName    String?  @map("lga_name")
  stateName  String?  @map("state_name")
  registered Int?
  repName    String?  @map("rep_name")
  lat        Float?
  lon        Float?
  source     String   @default("WHATSAPP")
  firstSeen  DateTime @default(now()) @map("first_seen") @db.Timestamptz(3)
  lastSeen   DateTime @default(now()) @map("last_seen") @db.Timestamptz(3)

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@id([electionId, code])
  @@index([electionId, stateCode, lgaCode, wardCode])
  @@map("polling_units")
}

model WaPosition {
  id         String   @id
  /// Defaulted to the 2023 project as a bridge. The raw-SQL writers in
  /// lib/db.js predate elections and do not set this column, so without a
  /// default every insert would fail the not-null constraint — which is
  /// exactly what a WhatsApp agent registering a new unit hit. Once every
  /// writer passes an election explicitly, drop the default so a row can
  /// never quietly land in the wrong project.
  electionId String   @default("elec_2023_presidential") @map("election_id")
  contactId  String   @map("contact_id")
  unitCode   String?  @map("unit_code")
  lat        Float
  lon        Float
  accuracy   Float?
  label      String?
  distanceM  Float?   @map("distance_m")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  election Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)
  contact  WaContact @relation(fields: [contactId], references: [id])

  @@index([contactId, createdAt])
  @@map("wa_positions")
}

model SheetRead {
  id         String   @id
  /// Defaulted to the 2023 project as a bridge. The raw-SQL writers in
  /// lib/db.js predate elections and do not set this column, so without a
  /// default every insert would fail the not-null constraint — which is
  /// exactly what a WhatsApp agent registering a new unit hit. Once every
  /// writer passes an election explicitly, drop the default so a row can
  /// never quietly land in the wrong project.
  electionId String   @default("elec_2023_presidential") @map("election_id")
  contactId  String?  @map("contact_id")
  unitCode   String?  @map("unit_code")
  mediaId    String?  @map("media_id")
  rawText    String?  @map("raw_text")
  parsed     String?
  confidence Float?
  /// Kept as an integer rather than promoted to a boolean: the column already
  /// holds 0 and 1 and the reading code already treats it that way.
  accepted   Int      @default(0)
  corrected  String?
  /// Which reader produced this — "claude", "google" or "local". Nullable
  /// because rows written before there was more than one reader cannot say.
  reader     String?
  /// Set when the reading came from the filing form rather than WhatsApp,
  /// where there is an account but no chat contact.
  userId     String?  @map("user_id")
  /// The contest the sheet was read for. WhatsApp readings predate it.
  race       String?
  /// "APP" or "WHATSAPP" — which way in the photograph arrived by.
  source     String   @default("WHATSAPP")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  election Election   @relation(fields: [electionId], references: [id], onDelete: Cascade)
  contact  WaContact? @relation(fields: [contactId], references: [id])

  @@index([electionId, createdAt])
  @@index([electionId, unitCode])
  @@map("sheet_reads")
}

/// What the commission announced, one row per place per election.
///
/// ── WHY THIS IS NOT A COLUMN ON Result ────────────────────────────────────
/// Two reasons, and the second is the one that matters. A single integer can
/// only say that some total moved, never which party's figure moved — and the
/// question worth asking is never "is the total different" but "did the
/// difference change who won". And a result row is a polling unit, while
/// collation announces wards and local governments hours before any unit sheet
/// is published. A ward figure has nowhere to live on a table keyed by booth,
/// and a ward is where a count is actually altered.
///
/// ── AND WHY IT IS NEVER MERGED INTO THE COUNT ─────────────────────────────
/// Nothing here is written into a Result and no Result is written into here. A
/// second, independently sourced figure for the same booths is the entire
/// point of running a parallel count; a schema that let either side correct
/// the other would destroy that quietly, and the only symptom would be a
/// comparison that always agrees.
model Declared {
  id          String   @id
  electionId  String   @map("election_id")
  /// Which contest was declared. A collation sheet announces one ballot paper,
  /// and holding our presidential count against a governorship declaration
  /// compares two different elections and reports the difference as a
  /// divergence — which is the exact failure the comparison exists to catch.
  race        String   @default("PRESIDENTIAL")
  /// UNIT, WARD, LGA or STATE — the level it was announced at, read off the
  /// shape of the code itself in lib/declared.js rather than chosen by hand.
  level       String
  /// The place's code at that level: 01/01/04/006, 01/01/04, 01/01, or 01. A
  /// truncation of the unit code, so both sides of the comparison derive their
  /// join key from the same string by the same function.
  placeKey    String   @map("place_key")
  stateCode   String?  @map("state_code")
  /// How many polling units this place contains, where the collation sheet
  /// said so. Null means nobody told us — and the comparison then stays
  /// partial rather than assuming complete coverage. It cannot be derived from
  /// polling_units, which records what has reported rather than what exists,
  /// and counting that would mark every place complete the moment it is
  /// covered at all.
  units       Int?
  registered  Int?
  accredited  Int?
  rejected    Int?
  /// JSON keyed by party, matching how Result stores votes.
  votes       String
  /// The total as the sheet stated it, kept beside the parties rather than
  /// replacing them: a row whose parties contradict its own stated total is
  /// itself a finding, and one this product has already met in the 2023 source.
  statedTotal Int?     @map("stated_total")
  total       Int
  source      String   @default("UPLOAD")
  note        String?
  enteredBy   String?  @map("entered_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  /// A place is declared once per contest. Collation correcting itself replaces
  /// the row rather than adding one — two rows for a ward is a total counted
  /// twice, and nobody spots that in an aggregate.
  @@unique([electionId, race, level, placeKey])
  @@index([electionId, stateCode])
  @@map("declared")
}


/// A polling unit coordinator: a separate population, held separately.
///
/// ── WHY NOT A ROW IN User ─────────────────────────────────────────────────
/// Everything about them differs from a Poll360 staff account. There are
/// thousands of them to a newsroom's handful, they are recruited in the
/// fortnight before polling day and finished the morning after, they sign
/// themselves up rather than being issued a credential down a phone line, and
/// they hold exactly one power — file the returns from one booth — where a
/// staff account holds a room. Sharing a table meant one sign-in page trying
/// to address both audiences and serving neither, and one code path where a
/// mistake made for the four thousand could reach the four.
///
/// The two systems meet in exactly one place: the bridge column on Result.
model Coordinator {
  id           String    @id
  name         String
  email        String?   @unique
  phone        String?   @unique
  passwordHash String    @map("password_hash")
  /// The booth they file for. A claim until an administrator agrees with it —
  /// which is what the approval queue is for, and why the approval screen can
  /// correct it before letting them in.
  unitCode     String?   @map("unit_code")
  stateCode    String?   @map("state_code")
  /// PENDING, ACTIVE, DECLINED or SUSPENDED. Four, because three could not say
  /// it: an account nobody has looked at, one somebody refused, and one that
  /// was approved and later switched off are three different facts, and only
  /// the first belongs in a queue.
  status       String    @default("PENDING")
  note         String?
  /// The administrator who decided. Points at `users` because approving is a
  /// staff act, which is the one direction these tables reference each other.
  approvedBy   String?   @map("approved_by")
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(3)
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(3)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  approver  User?                 @relation("CoordinatorApprovedBy", fields: [approvedBy], references: [id])
  sessions  CoordinatorSession[]
  results   Result[]
  incidents Incident[]

  @@index([status, createdAt])
  @@index([unitCode])
  @@map("coordinators")
}

/// Their own sessions, on their own cookie.
///
/// A twin of Session, deliberately not a shared table. The token is stored
/// hashed for the same reason it is there: a leaked backup then carries no
/// usable credentials. Kept separate so a coordinator's token is meaningless
/// to the staff lookup and vice versa — parameterising one table over the
/// other would have saved a few lines and turned a mistyped argument into a
/// privilege escalation.
model CoordinatorSession {
  id            String   @id
  coordinatorId String   @map("coordinator_id")
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(3)
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  coordinator Coordinator @relation(fields: [coordinatorId], references: [id], onDelete: Cascade)

  @@index([coordinatorId])
  @@index([expiresAt])
  @@map("coordinator_sessions")
}
