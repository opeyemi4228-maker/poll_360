# Copy to .env.local and adjust.

# The canonical origin, used for metadataBase, sitemap, manifest and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://poll360.ng

# The polling unit agents' own address. When set, the pages in app/agent are
# served at the root of this domain (/login, /join, /pending, /) and the main
# site sends /agent/... across to it. Leave empty to keep them on /agent, which
# is right for local work and preview deployments. To try it locally:
#   NEXT_PUBLIC_AGENT_URL=http://agent.localhost:3000
NEXT_PUBLIC_AGENT_URL=

# Data Bank's agent list. Agents sign in with a code and nothing else, and
# Data Bank confirms it on every sign-in; the approval screen reads the list
# from it too. DATABANK_URL falls back to DUMPSITE_URL. The key is issued in
# Data Bank for POLL360 with the scopes agents:register, agents:approve and
# agents:confirm.
DATABANK_AGENTS_KEY=

# Agent360, for check-ins and the SOS on the agents' app. Both apps hold the
# same AGENT_DOOR_SECRET. Leave both empty and the app has no check-in section.
AGENT360_URL=
AGENT_DOOR_SECRET=

# ---------------------------------------------------------------------------
# Database
#
# Postgres, and it is not optional.
#
# Storage used to be a SQLite file, which is right on one machine and wrong the
# moment this is deployed anywhere serverless: the filesystem does not survive
# between invocations, so every result filed since the last deploy disappears
# without an error. On Vercel it did not even get that far, sign in returned a
# server error because the file could not be opened at all.
#
# Use Neon's POOLED connection string, the host with -pooler in its name. The
# direct host is for migrations and long sessions, and pointing a serverless
# deployment at it exhausts connections under any real load.
#
# Never commit the real value. This file is checked in; .env.local is not.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"
#
# Data Bank's database, added beside the original when that one ran out of
# room. When set, Poll360 reads and saves here instead; DATABASE_URL and the
# original database are left exactly as they are, and unsetting this goes back
# to them. Copy the tables across first with scripts/copy-to-databank.mjs,
# then set this — pointed at Data Bank before the copy, Poll360 finds no tables.
DATABANK_DATABASE_URL=
# ---------------------------------------------------------------------------

# Creating the first account. There is no public sign-up, so the first user is
# made by the seed script and these are read only by it:
#
#   ADMIN_EMAIL=you@poll360.ng ADMIN_PASSWORD='a long one' npm run db:seed
#
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
# ADMIN_PHONE=

# ---------------------------------------------------------------------------
# Encryption at rest.
#
# Seals the fields that would actually hurt if the database were taken:
# incident narratives, agent contact details, result-sheet keys. Vote totals
# stay in the clear, because a column you cannot aggregate is one you cannot draw
# a map from. AES-256-GCM, so a tampered row fails loudly instead of decrypting
# to something else.
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Without it the app runs on a known development key and says so on every boot,
# and it refuses to start in production at all.
# 32 random bytes, base64:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# This cannot change once data exists. Anything sealed with the old key becomes
# unreadable, permanently, and nothing errors at the point of loss. Missing, the
# app runs on a development key and says so: sealed fields are then NOT secret.
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Still to come with the application tier (see STRUCTURE.md §2):
#
# SHEET_STORAGE_URL=…   where result-sheet bytes live
# SMS_API_KEY=…         one-time codes to field agents
# ---------------------------------------------------------------------------

